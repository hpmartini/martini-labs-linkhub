  "animations": {
    "transitions": {
      "default": "all 0.15s cubic-bezier(0.4, 0, 0.2, 1)",
      "slow": "all 0.3s cubic-bezier(0.4, 0, 0.2, 1)",
      "fast": "all 0.1s cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "hoverEffects": {
      "buttonLift": {
        "transform": "translateY(-4px)",
        "description": "Primary buttons lift up on hover"
      },
      "cardLift": {
        "transform": "translateY(-2px)",
        "boxShadow": "increased",
        "description": "Cards lift slightly with enhanced shadow on hover"
      },
      "linkColorChange": {
        "description": "Links transition color smoothly on hover"
      }
    },
    "scrollAnimations": {
      "fadeInUp": {
        "initial": {
          "opacity": "0",
          "transform": "translateY(20px)"
        },
        "animate": {
          "opacity": "1",
          "transform": "translateY(0)"
        },
        "duration": "0.6s",
        "description": "Elements fade in and slide up when entering viewport"
      }
    },
    "timingFunction": "cubic-bezier(0.4, 0, 0.2, 1)"
  },

  "doNotRules": [
    "DO NOT apply card shadow to text elements",
    "DO NOT use teal (#2F4F4F) for body text - it's only for buttons and accents",
    "DO NOT use burgundy (#A63333) for backgrounds - it's only for text highlights and links",
    "DO NOT apply button padding to inline links",
    "DO NOT use full border-radius (9999px) on cards - only on badges and pills",
    "DO NOT apply dark section background (#0F172A) to cards",
    "DO NOT use tagline badge styles for regular text",
    "DO NOT apply hover transform to text elements",
    "DO NOT use uppercase text-transform for body copy",
    "DO NOT apply letter-spacing to paragraph text",
    "DO NOT use the tagline orange (#FFEDD5) as a primary color - it's only for badges",
    "DO NOT mix font weights randomly - follow the typography hierarchy strictly",
    "DO NOT apply card shadows to buttons - buttons have their own shadow definition",
    "DO NOT use border-radius on sections - only on cards, buttons, and inputs"
  ],

  "applicationContext": {
    "tealColor": {
      "useFor": ["Primary buttons", "CTA buttons", "Section labels", "Check icons", "Active pill indicators", "EOAD method circles"],
      "doNotUseFor": ["Body text", "Headlines", "Card backgrounds", "Borders"]
    },
    "burgundyColor": {
      "useFor": ["Highlighted text in headlines", "Read more links", "Submit buttons (contact form)", "Link hover states"],
      "doNotUseFor": ["Backgrounds", "Card shadows", "Borders", "Body text"]
    },
    "shadows": {
      "cardShadow": ["Cards", "Blog cards", "Service cards"],
      "buttonShadow": ["Primary CTA buttons only"],
      "noShadow": ["Text", "Icons", "Badges", "Navigation"]
    },
    "borderRadius": {
      "12px": ["Cards", "Buttons (primary/secondary)", "Form inputs", "Blog card images"],
      "8px": ["Navigation contact button", "Form inputs"],
      "9999px": ["Badges", "Pills", "Industry selector buttons"]
    }
  },

  "responsiveBreakpoints": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
