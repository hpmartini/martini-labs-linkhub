          "transform": "translateY(-4px)",
          "boxShadow": "0 10px 15px -3px rgba(47, 79, 79, 0.2), 0 4px 6px -4px rgba(47, 79, 79, 0.2)"
        },
        "transition": "all 0.15s cubic-bezier(0.4, 0, 0.2, 1)"
